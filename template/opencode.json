{
  "$schema": "https://opencode.ai/config.json",
<: if 'opencode' in AGENT_CLIENTS and OPENCODE_PROVIDER not in ['user', 'named'] :>  "model": <% (OPENCODE_PROVIDER ~ '/' ~ OPENCODE_MODEL) | tojson %>,
  "providers": {
    <% OPENCODE_PROVIDER | tojson %>: {
      "name": <% {'llama-cpp': 'llama.cpp (local)', 'ollama': 'Ollama (local)', 'vllm': 'vLLM (local)', 'lmstudio': 'LM Studio (local)'}.get(OPENCODE_PROVIDER, 'OpenAI-compatible server') | tojson %>,
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": <% OPENCODE_BASE_URL.rstrip('/') | tojson %>
      },
      "models": {
        <% OPENCODE_MODEL | tojson %>: {
          "modelID": <% OPENCODE_MODEL | tojson %>,
          "name": <% OPENCODE_MODEL | tojson %>,
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": <% OPENCODE_CONTEXT | int %>,
            "output": 8192
          }
        }
      }
    }
  },
<: elif 'opencode' in AGENT_CLIENTS and OPENCODE_PROVIDER == 'named' :>  "model": <% OPENCODE_MODEL | tojson %>,
<: endif :>  "compaction": {
    "auto": false
  },
  "mcp": {
    "servers": {
      "code-review-graph": {
        "type": "local",
        "command": [
          "uvx",
          "code-review-graph==2.3.9",
          "serve",
          "--tools",
          "build_or_update_graph_tool,run_postprocess_tool,get_minimal_context_tool,get_impact_radius_tool,query_graph_tool,get_review_context_tool,semantic_search_nodes_tool,list_graph_stats_tool,get_docs_section_tool,find_large_functions_tool,list_flows_tool,get_flow_tool,get_affected_flows_tool,list_communities_tool,get_community_tool,get_architecture_overview_tool,detect_changes_tool,refactor_tool,apply_refactor_tool,generate_wiki_tool,get_wiki_page_tool,get_hub_nodes_tool,get_bridge_nodes_tool,get_knowledge_gaps_tool,get_surprising_connections_tool,get_suggested_questions_tool,traverse_graph_tool,list_repos_tool,cross_repo_search_tool"
        ],
        "environment": {
          "GOOGLE_API_KEY": "",
          "VOYAGE_API_KEY": "",
          "MINIMAX_API_KEY": "",
          "CRG_OPENAI_API_KEY": "",
          "CRG_OPENAI_BASE_URL": "",
          "CRG_ACCEPT_CLOUD_EMBEDDINGS": ""
        }
      },
      "scrapling": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "scrapling[ai]==0.4.15",
          "--with",
          "playwright==1.63.0",
          "--with",
          "patchright==1.63.0",
          "scrapling",
          "mcp"
        ]
      }
    }
  },
  "permissions": [
    {
      "action": "scrapling_stealthy_fetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "scrapling_bulk_stealthy_fetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "scrapling_open_session",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "scrapling_session_fetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "scrapling_fetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "scrapling_bulk_fetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "code-review-graph_apply_refactor_tool",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "code-review-graph_generate_wiki_tool",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*.pdf",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "build/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "how-to/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "typeset/src/units/.base/*",
      "effect": "deny"
    },
    {
      "action": "code-review-graph_embed_graph_tool",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
